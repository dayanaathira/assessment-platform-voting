# Copy to .env and adjust to match the Postgres you develop against.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_NAME=app_db
POSTGRES_SCHEMA=feature_dev
POSTGRES_USER=postgres
POSTGRES_PASS=postgres

# Port the service listens on. Omit to use DEFAULT_PORT from src/app.constants.ts.
PORT=3000

NODE_ENV=development

# Structured stdout log level. `http` includes one access log per request.
LOG_LEVEL=http

# Browser origins allowed to call this service, comma-separated. Required —
# there is no fallback, deliberately, so that an unset value fails at startup
# instead of silently allowing a localhost origin in staging. An internal
# service that no browser calls should remove CORS entirely instead.
CORS_ORIGINS=http://localhost:4200

# Swagger UI. Off in production unless this is explicitly true; on elsewhere
# unless explicitly false.
# SWAGGER_ENABLED=true

# How many reverse proxies sit between the internet and this process — an
# nginx front door alone is 1. Unset means Express trusts nothing, so req.ip
# is the socket peer: behind a proxy that is the proxy, and every client shows
# up in the access log as the same address. Set the real hop count to fix that.
#
# Never express this as a boolean `trust proxy: true`: that takes the leftmost
# X-Forwarded-For entry, which the caller writes, so any client can put
# whatever address it likes in your logs. It also changes req.protocol,
# req.secure and req.hostname.
# TRUST_PROXY_HOPS=1

# Boot-time migration lock. Only one instance applies migrations at a time;
# the others wait and then find nothing pending. On timeout, startup fails
# rather than serving against a schema nobody finished migrating.
# These match the built-in defaults, so only set them if you need to.
DB_MIGRATION_LOCK_NAME=feature_voting_db_migration
DB_MIGRATION_LOCK_TIMEOUT_MS=30000
DB_MIGRATION_LOCK_POLL_MS=500
