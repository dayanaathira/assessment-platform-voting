# Copy to .env next to docker-compose.yml and replace every "replace-…" value.
# Generate secrets with: openssl rand -base64 48

# Database (created by the postgres container on first start)
POSTGRES_DB=feature_voting
POSTGRES_USER=feature_voting
POSTGRES_PASSWORD=replace-with-a-database-password

# JWT signing secrets: at least 32 characters each and different from each other
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-32-chars

# Passwords for the seeded users (admin, user1-user3), at least 8 characters
SEED_ADMIN_PASSWORD=replace-with-admin-password
SEED_USER_PASSWORD=replace-with-user-password

# Host ports
WEB_PORT=8080
API_PORT=3000

# The address people open in the browser, e.g. http://203.0.113.10:8080 or
# https://feedback.example.com. Used for CORS on the API.
WEB_ORIGIN=http://localhost:8080

# Swagger UI on API_PORT. Set to false on a public server.
SWAGGER_ENABLED=true
